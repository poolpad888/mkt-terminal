[Unit]
Description=FINFACTS Telegram collector
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/finfacts
Environment=TG_API_ID=37598766
Environment=TG_API_HASH=0a952239efd4866c8f619288942229df
Environment=TG_POLL_MS=3000
Environment=DATABASE_URL=postgres://finfacts:faf91788f3f773479f1a954426ed894f@127.0.0.1:5432/finfacts
ExecStart=/usr/bin/node /opt/finfacts/tg/collector.js
Restart=always
RestartSec=15
# Сторож может перезапускать процесс часто, если Телеграм недоступен.
# Снимаем ограничение systemd на число перезапусков, иначе служба
# окончательно заглохнет и её придётся поднимать руками.
StartLimitIntervalSec=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
